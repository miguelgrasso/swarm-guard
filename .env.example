# Model provider: bedrock | ollama
MODEL_PROVIDER=bedrock

# AWS region for Bedrock (us-east-2 only)
AWS_REGION=us-east-2

# Bedrock model ID (leave empty to use provider default)
BEDROCK_MODEL_ID=

# Price per token in USD (used to compute CostPerRun metric)
TOKEN_PRICE_PER_UNIT=0.000003

# Budget guard: max tokens per swarm run (dev/tests; use 50000+ for real Bedrock runs)
BUDGET_GUARD_MAX_TOKENS=5000

# Benchmark output directory for JSON results
BENCHMARK_OUTPUT_DIR=./results

# Swarm configuration to run: baseline | guarded
SWARM_CONFIG=baseline

# Budget alarm threshold in USD (triggers CloudWatch alarm when exceeded)
BUDGET_ALARM_THRESHOLD_USD=5.0
